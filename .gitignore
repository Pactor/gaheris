# Secrets -- never commit. Copy .env.example to .env and set your own.
.env
.dbpass

# Database dumps. These are large, and a dump of a live server contains
# account rows with password hashes. The migrations in sql/ rebuild the
# world on a fresh import, so a dump is never the thing to share.
*.sql.gz
*.dump
backup-*.sql
pre-import-backup.sql
restore-guard-levels.sql

# Build scratch from assembling the scripts by hand
*.bak
*.err
merc_head.cs
merc_body.cs
merc_tail.cs
keep_*.txt
gear_methods.txt

# Client installer payloads
*.bin
*.exe

# Tooling
obj/
bin/
__pycache__/

# Generated from db-public, which is a separate project with its own history.
# 11 MB of INSERTs is not ours to redistribute, and tools/mkatlantis.py rebuilds
# it in seconds from a db-public checkout.
sql/13-atlantis-mobs.sql

# Generated from a CapnBry harvest; tools/mkvolcanus.py rebuilds it.
sql/15-volcanus.sql
